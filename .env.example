# Ghana National CAP Platform — environment template.
# Copy to .env and fill in real values. Do NOT commit .env (already in .gitignore).
#
# All values are optional unless marked [required]. Missing optional values
# trigger the graceful-degradation path: the app still boots, the workflow
# still runs end-to-end, and external integrations log/mock instead of failing.

# ─────────────────────────────────────────────────────────────
# Flask
# ─────────────────────────────────────────────────────────────

# [Phase 1 fallback exists; rotate in Phase 2]
# Random secret for signing session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
FLASK_SECRET_KEY=

# ─────────────────────────────────────────────────────────────
# GMeT webhook (incoming)
# ─────────────────────────────────────────────────────────────

# [Phase 1 fallback exists; rotate in Phase 2]
# Shared secret with the GMeT webhook caller — sent as X-CAP-API-KEY header.
# Current production-bound value is preserved as a code fallback so the contract
# doesn't break during migration. Set this in your .env to override the fallback
# and ready Phase 2 rotation.
GMET_WEBHOOK_API_KEY=

# ─────────────────────────────────────────────────────────────
# MongoDB (operational store)
# ─────────────────────────────────────────────────────────────

# [recommended] MongoDB Atlas connection string. Without this, db.get_db()
# falls back to a hardcoded literal in db.py (Phase 2 will remove the fallback).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/fsrp_aggregator?retryWrites=true&w=majority
DB_NAME=fsrp_aggregator

# ─────────────────────────────────────────────────────────────
# OpenAI (translation + TTS for all languages)
# ─────────────────────────────────────────────────────────────

# Bare API key string (NOT wrapped in OpenAI(api_key="…") — that was a Phase 3
# bug that silently mocked all translations and TTS).
OPENAI_API_KEY=

# ─────────────────────────────────────────────────────────────
# Google Gemini API — Gemma 4 (advisory agent)
# ─────────────────────────────────────────────────────────────

# Bare API key string from Google AI Studio (https://aistudio.google.com).
# Without it, /api/v1/agents/draft returns a clearly-marked mock advisory.
GEMINI_API_KEY=

# Model ID. Defaults to `gemma-4-26b-a4b-it` (the smaller / faster Gemma 4
# variant — the larger option is `gemma-4-31b-it`).
GEMINI_MODEL=gemma-4-26b-a4b-it

# ─────────────────────────────────────────────────────────────
# Resend (transactional email — OTP delivery)
# ─────────────────────────────────────────────────────────────

# API key from Resend (https://resend.com). Without it, the verification
# code is logged to stdout and the login flow continues for dev.
RESEND_API_KEY=

# Verified sender. The default `onboarding@resend.dev` is Resend's shared
# sandbox sender, restricted to delivering to the account owner's inbox —
# fine for dev/smoke. Replace with a verified domain for production.
RESEND_FROM=Ghana CAP Platform <onboarding@resend.dev>

# ─────────────────────────────────────────────────────────────
# Africa's Talking (Phase 2 — primary SMS for 2FA + dispatch)
# ─────────────────────────────────────────────────────────────

# Sandbox keys for tests; production keys for real dispatch.
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_FROM=

# ─────────────────────────────────────────────────────────────
# Twilio (fallback SMS — kept as adapter)
# ─────────────────────────────────────────────────────────────

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─────────────────────────────────────────────────────────────
# Dispatch
# ─────────────────────────────────────────────────────────────

# MNO webhook receiver URL. When unset, Phase 8 will default this to the local
# /public/feed/receive endpoint so the dispatch loop closes for testing.
MNO_WEBHOOK_URL=http://localhost:5000/public/feed/receive

# ─────────────────────────────────────────────────────────────
# Map / Geocoding (Phase 5)
# ─────────────────────────────────────────────────────────────

# Mapbox token for the operator dashboard globe + flyTo + Mapbox Geocoding.
# Without it, the frontend falls back to MapLibre + Nominatim.
VITE_MAPBOX_TOKEN=

# ─────────────────────────────────────────────────────────────
# CORS (Phase 2 — restrict from "*" to known origins)
# ─────────────────────────────────────────────────────────────

# Comma-separated list of allowed origins for Socket.IO. Default in code is
# still "*" until Phase 2 wires this through.
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5173

# ─────────────────────────────────────────────────────────────
# Postgres analytics (external — schema in earlywarningdb.sql)
# ─────────────────────────────────────────────────────────────

# Connection string for the external analytics DB owned by another team.
# Without it, services/external_analytics_service.sync_alert logs only.
POSTGRES_DSN=

# ─────────────── Phase 4: React Frontend ───────────────
# The Vite dev server (port 5173) is already in the default ALLOWED_ORIGINS.
# Override only if you change the Vite dev port or deploy split-origin.
# ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5173

# Frontend env vars (all optional; live in frontend/.env.development if used).
# VITE_*-prefixed vars leak to the client bundle — never put secrets here.
# VITE_API_BASE=               # Defaults to current origin — only set for split-origin deploys.
